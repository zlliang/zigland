---
import Link from "@/components/Link.astro"

interface Props {
  name?: boolean
  link?: boolean
}

const { name = true, link = true } = Astro.props
const Component = link ? Link : "div"
---

<Component href="/" class="inline-flex items-center gap-[0.4em] font-display font-bold nocolor">
  <img src="/logo.svg" class="h-[1.1em]" />
  {name && <span>Zigland</span>}
</Component>

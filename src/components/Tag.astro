---
import { cn } from "@/utils/style"

interface Props {
  icon?: string
  class?: string
}

const { icon, class: className } = Astro.props
---

<span class={cn("inline-block px-1 py-px border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 text-neutral-500 text-sm", className)}>
  {icon && <span class={cn(icon, "mr-px")} />}
  <slot />
</span>

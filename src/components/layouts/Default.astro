---
import Logo from "@/components/Logo.astro"
import Footer from "@/components/Footer.astro"
---

<div class="flex flex-col min-h-dvh max-w-3xl m-auto px-6">
  <header class="flex justify-between items-center mb-16 h-12">
    <div class="flex items-center gap-2">
      <Logo />
      <div><slot name="header-suffix" /></div>
    </div>
  </header>
  <main class="flex-1">
    <slot />
  </main>
  <Footer class="mt-16 mb-8 text-center" />
</div>

---
import Logo from "@/components/Logo.astro"
import Link from "@/components/Link.astro"
import Footer from "@/components/Footer.astro"
---

<div class="flex flex-col min-h-dvh max-w-3xl m-auto px-6">
  <header class="flex flex-col items-center my-16">
    <h1 class="-translate-x-1"><Logo link={false} /></h1>
    <p class="font-bold text-neutral-500">
      Grow together with <Link href="https://ziglang.org">Zig</Link>.
    </p>
  </header>
  <main class="flex-1">
    <slot />
  </main>
  <Footer class="mt-16 mb-8 text-center" />
</div>

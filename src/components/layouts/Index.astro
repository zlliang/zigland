---
import Logo from "@/components/Logo.astro"
import Footer from "@/components/Footer.astro"
---

<div class="flex flex-col min-h-dvh max-w-3xl m-auto px-6">
  <header class="flex flex-col items-center my-16">
    <h1 class="-translate-x-2"><Logo link={false} /></h1>
    <p class="font-bold text-neutral-500 dark:text-neutral-400">
      Grow together with
      <a href="https://ziglang.org" target="_blank" rel="nofollow noopener noreferrer">Zig</a>.
    </p>
  </header>
  <main class="flex-1">
    <slot />
  </main>
  <Footer class="mt-16 mb-8 text-center" />
</div>

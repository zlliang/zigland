---
import Layout from "@/components/Layout.astro"
import Link from "@/components/Link.astro"
import Tag from "@/components/Tag.astro"
---

<Layout type="index">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
    <div class="relative">
      <Link href="/play" class="flex items-center gap-6 px-6 py-4 border border-neutral-200 dark:border-neutral-800 hover:border-amber-200 dark:hover:border-amber-800 hover:bg-amber-50 dark:hover:bg-amber-950 secondary">
        <span class="icon-[lucide--bird] size-10!" />
        <div>
          <div class="font-semibold font-display">Playground</div>
          <div class="text-sm">Experiment with Zig code in your browser</div>
        </div>
      </Link>
      <Tag icon="icon-[lucide--sparkles]" class="absolute -top-2 -right-2">Alpha</Tag>
    </div>
  </div>
  <div class="prose">
    <p>
      🚧 <strong>Status:</strong> Work in Progress
    </p>
    <p>
      Zigland is your hub for learning and exploring the Zig programming language, and more broadly,
      system programming. The vision is to provide:
    </p>
    <ul>
      <li><strong>Comprehensive Tutorials</strong> — Learn Zig and system programming from the ground up</li>
      <li><strong>Interactive Playground</strong> — Experiment with Zig code in your browser (inspired by <Link href="https://www.typescriptlang.org/play" class="secondary">typescriptlang.org/play</Link>)</li>
      <li><strong>Language Cheat Sheet</strong> — Quick reference guide (inspired by <Link href="https://cheats.rs" class="secondary">cheats.rs</Link>)</li>
      <li><strong>Newsletters and Posts</strong> — Regular updates about Zig and its ecosystem</li>
    </ul>
    <p>
      The site is still under development. I look forward to exploring the Zig world together with you!
    </p>
  </div>
</Layout>
